#!/usr/bin/env bash
# CLI Menu - 交互式菜单前端

set -e

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

# 检查 cli-switch 是否安装
if ! command -v cli-switch &> /dev/null; then
    echo -e "${RED}错误：cli-switch 未安装${NC}"
    echo "请先运行：cd ~/projects/cli-switch && pip3 install --break-system-packages -e ."
    exit 1
fi

# 清屏
clear_screen() { clear; }

# 主菜单
show_main_menu() {
    echo ""
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${NC}              ${GREEN}AI CLI 工具选择${NC}                                ${CYAN}║${NC}"
    echo -e "${CYAN}╠══════════════════════════════════════════════════════════════╣${NC}"
    echo -e "${CYAN}║${NC}                                                              ${CYAN}║${NC}"
    echo -e "${CYAN}║${NC}  ${YELLOW}1) Claude Code CLI${NC}                                      ${CYAN}║${NC}"
    echo -e "${CYAN}║${NC}     支持模型：fucheers(1) + 智谱 (2) + 百炼 (8) = 11 个模型   ${CYAN}║${NC}"
    echo -e "${CYAN}║${NC}                                                              ${CYAN}║${NC}"
    echo -e "${CYAN}║${NC}  ${YELLOW}2) Gemini CLI${NC}                                           ${CYAN}║${NC}"
    echo -e "${CYAN}║${NC}     支持模型：智谱 (2) + Google Gemini (4) = 6 个模型       ${CYAN}║${NC}"
    echo -e "${CYAN}║${NC}                                                              ${CYAN}║${NC}"
    echo -e "${CYAN}║${NC}  ${YELLOW}3) Codex CLI${NC}                                            ${CYAN}║${NC}"
    echo -e "${CYAN}║${NC}     支持模型：百炼 (8) + OpenAI(1) = 9 个模型                 ${CYAN}║${NC}"
    echo -e "${CYAN}║${NC}                                                              ${CYAN}║${NC}"
    echo -e "${CYAN}║${NC}  ${GREEN}4) 测试所有模型${NC}                                          ${CYAN}║${NC}"
    echo -e "${CYAN}║${NC}  ${GREEN}5) 显示当前状态${NC}                                          ${CYAN}║${NC}"
    echo -e "${CYAN}║${NC}                                                              ${CYAN}║${NC}"
    echo -e "${CYAN}║${NC}  ${RED}0) 退出${NC}                                                    ${CYAN}║${NC}"
    echo -e "${CYAN}║${NC}                                                              ${CYAN}║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${YELLOW}提示：选择工具后将直接进入模型选择，确认后启动 CLI${NC}"
    echo ""
}

# 获取用户输入
get_input() {
    local prompt="$1"
    local max="$2"
    while true; do
        read -p "$prompt" choice
        if [[ "$choice" == "0" ]]; then echo "0"; return; fi
        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$max" ]; then
            echo "$choice"; return
        fi
        echo -e "${RED}请输入 1-$max 或 0 之间的数字${NC}"
    done
}

# 显示模型菜单
show_model_menu() {
    local tool="$1"
    clear_screen
    echo ""
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${NC}  ${GREEN}${tool^^} 模型选择${NC}                                          ${CYAN}║${NC}"
    echo -e "${CYAN}╠══════════════════════════════════════════════════════════════╣${NC}"

    cli-switch --json list 2>/dev/null | python3 -c "
import sys, json
data = json.load(sys.stdin)
tool = '$tool'
if tool in data:
    for i, m in enumerate(data[tool], 1):
        desc = m.get('description', '')[:20]
        print(f\"  {i}) {m['key']:15} → {m['name']:25} {desc}\")
"
    echo -e "${CYAN}║${NC}                                                              ${CYAN}║${NC}"
    echo -e "${CYAN}║${NC}  ${RED}0) 返回主菜单${NC}                                            ${CYAN}║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${YELLOW}提示：选择模型后将切换并启动${NC}"
    echo ""
}

# 切换模型（仅切换，不启动 CLI）
switch_model_only() {
    local tool="$1"
    local idx="$2"

    local model_key=$(cli-switch --json list 2>/dev/null | python3 -c "
import sys, json
data = json.load(sys.stdin)
models = data.get('$tool', [])
idx = $idx - 1
if 0 <= idx < len(models):
    print(models[idx]['key'])
")

    if [ -n "$model_key" ]; then
        echo ""
        echo -e "${GREEN}正在切换到：${model_key}...${NC}"
        cli-switch --tool "$tool" "$model_key"
        echo ""
        echo -e "${GREEN}切换完成！${NC}"
    fi
}

# 切换模型并启动 CLI
switch_model_and_launch() {
    local tool="$1"
    local idx="$2"

    local model_key=$(cli-switch --json list 2>/dev/null | python3 -c "
import sys, json
data = json.load(sys.stdin)
models = data.get('$tool', [])
idx = $idx - 1
if 0 <= idx < len(models):
    print(models[idx]['key'])
")

    if [ -n "$model_key" ]; then
        echo ""
        echo -e "${GREEN}正在切换到：${model_key}...${NC}"
        cli-switch --tool "$tool" "$model_key"
        echo ""
        echo -e "${GREEN}正在启动 $tool CLI...${NC}"
        echo -e "${YELLOW}按 Ctrl+C 退出 CLI${NC}"
        echo ""
        case "$tool" in
            claude) claude ;;
            gemini) gemini ;;
            codex) codex ;;
        esac
    fi
}

# 测试所有模型
test_all_models() {
    clear_screen
    echo ""
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${NC}  ${YELLOW}正在测试所有模型 (端到端聊天测试)...${NC}                        ${CYAN}║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    cli-switch chat-test 2>&1
    echo ""
    read -p "按回车键继续..." -n 1 -r
    echo
}

# 显示状态
show_status() {
    clear_screen
    echo ""
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${NC}  ${YELLOW}当前状态${NC}                                                  ${CYAN}║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    cli-switch status
    echo ""
    read -p "按回车键继续..." -n 1 -r
    echo
}

# 主程序
main() {
    while true; do
        clear_screen
        show_main_menu

        local choice=$(get_input "请选择 (0-5): " 5)

        case "$choice" in
            0) clear_screen; echo -e "${GREEN}👋 再见！${NC}"; exit 0 ;;
            1)
                # Claude Code
                show_model_menu "claude"
                local count=$(cli-switch --json list 2>&1 | python3 -c "import sys,json; print(len(json.load(sys.stdin).get('claude', [])))")
                local model_choice=$(get_input "请选择模型 (0-$count): " "$count")
                if [ "$model_choice" != "0" ]; then
                    switch_model_and_launch "claude" "$model_choice"
                fi
                ;;
            2)
                # Gemini
                show_model_menu "gemini"
                local count=$(cli-switch --json list 2>&1 | python3 -c "import sys,json; print(len(json.load(sys.stdin).get('gemini', [])))")
                local model_choice=$(get_input "请选择模型 (0-$count): " "$count")
                if [ "$model_choice" != "0" ]; then
                    switch_model_and_launch "gemini" "$model_choice"
                fi
                ;;
            3)
                # Codex
                show_model_menu "codex"
                local count=$(cli-switch --json list 2>&1 | python3 -c "import sys,json; print(len(json.load(sys.stdin).get('codex', [])))")
                local model_choice=$(get_input "请选择模型 (0-$count): " "$count")
                if [ "$model_choice" != "0" ]; then
                    switch_model_and_launch "codex" "$model_choice"
                fi
                ;;
            4) test_all_models ;;
            5) show_status ;;
            *) echo -e "${RED}无效选项${NC}"; sleep 1 ;;
        esac
    done
}

# 处理命令行参数
if [ -n "$1" ]; then
    cli-switch "$@"
else
    main
fi
