def validate_config():
    """启动时验证配置完整性，发现问题提前报错"""
    errors = []
    for tool_key, tool in TOOLS.items():
        # 检查必要字段
        if "name" not in tool:
            errors.append(f"工具 '{tool_key}' 缺少 'name' 字段")
        if "command" not in tool:
            errors.append(f"工具 '{tool_key}' 缺少 'command' 字段")
        if "models" not in tool:
            errors.append(f"工具 '{tool_key}' 缺少 'models' 字段")
            continue
        # 检查 command 是否可用
        cmd = tool["command"].split()[0]
        if not shutil.which(cmd):
            errors.append(f"工具 '{tool_key}' 的命令 '{cmd}' 不在 PATH 中")
        # 检查模型 key 唯一性
        all_keys = []
        for provider in tool["models"].values():
            for model in provider.get("models", []):
                if model["key"] in all_keys:
                    errors.append(f"工具 '{tool_key}' 中模型 key '{model['key']}' 重复")
                all_keys.append(model["key"])
    return errors

def clear_screen():
    """清屏"""
    os.system('cls' if os.name == 'nt' else 'clear')

def print_box_header(title, width=68):
    """打印方框标题"""
    print("╔" + "═" * (width - 2) + "╗")
    print("║" + title.center(width - 2) + "║")
    print("╠" + "═" * (width - 2) + "╣")
    print("║" + " " * (width - 2) + "║")

def print_box_footer(width=68):
    """打印方框底部"""
    print("║" + " " * (width - 2) + "║")
    print("╚" + "═" * (width - 2) + "╝")

def print_menu_item(idx, text, width=68):
    """打印菜单项"""
    print("║ " + f"{idx}) {text}".ljust(width - 4) + " ║")

def print_separator(width=68):
    """打印分隔线"""
    print("║" + " " * (width - 2) + "║")

def format_model_summary(tool_key):
    """动态生成模型统计摘要"""
    tool = TOOLS[tool_key]
    parts = []
    for category in tool["models"].values():
        count = len(category["models"])
        parts.append(f"{category['name']}({count})")
    total = get_total_model_count(tool_key)
    return " + ".join(parts) + f" = {total} 个模型"

def print_main_menu():
    """打印主菜单"""
    print_box_header("         AI CLI 工具选择", 68)
    print("║                                                              ║")
    claude_summary = format_model_summary("claude")
    print(f"║  1) Claude Code CLI                                          ║")
    print(f"║     支持模型：{claude_summary:<44s}║")
    print("║                                                              ║")
    gemini_summary = format_model_summary("gemini")
    print(f"║  2) Gemini CLI                                               ║")
    print(f"║     支持模型：{gemini_summary:<44s}║")
    print("║                                                              ║")
    codex_summary = format_model_summary("codex")
    print(f"║  3) Codex CLI                                                 ║")
    print(f"║     支持模型：{codex_summary:<44s}║")
    print("║                                                              ║")
    print("║  4) 测试所有工具                                              ║")
    print("║                                                              ║")
    print("║  0) 退出                                                     ║")
    print("║                                                              ║")
    print_box_footer(68)

def print_models_menu(tool_key):
    """打印工具的模型菜单"""
    tool = TOOLS[tool_key]
    total_models = get_total_model_count(tool_key)

    print_box_header(f"         {tool['name']} 模型选择 ({total_models}个模型)", 68)

    idx = 1
    for category_key, category in tool["models"].items():
        print("║                                                              ║")
        print("║  【" + category["name"] + "】" + " " * (66 - len(category["name"]) - 5) + " ║")

        for model in category["models"]:
            display_text = f"{model['key']:<12} → {model['name']:<30} {model['desc']}"
            print_menu_item(idx, display_text, 68)
            idx += 1

    print("║                                                              ║")
    print_menu_item(0, "退出", 68)
    print_box_footer(68)

def print_test_results(results):
    """打印测试结果"""
    print_box_header("         工具测试结果", 68)

    for tool_key, tool_results in results.items():
        tool = TOOLS[tool_key]
        print("║                                                              ║")
        print("║  【" + tool['name'] + "】".ljust(67) + " ║")

        if tool_results["available"]:
            print("║                                                              ║")
            print("║  状态：✅ 可用                                               ║")
            print("║  版本：" + tool_results["version"].ljust(57) + " ║")
            print("║  支持的模型：                                                  ║")

            idx = 1
            for cat_key, category in tool["models"].items():
                print("║                                                              ║")
                print("║    " + category["name"] + ":" + " " * (65 - len(category["name"]) - 5) + " ║")
                for model in category["models"]:
                    status = "✅" if model.get("tested", True) else "❓"
                    print("║    " + status + " " + f"{idx}. {model['name']}".ljust(62) + " ║")
                    idx += 1
        else:
            print("║                                                              ║")
            print("║  状态：❌ 不可用                                             ║")
            print("║  错误：" + tool_results["error"].ljust(57) + " ║")

    print_box_footer(68)

def check_tool_available(tool_key):
    """检查工具是否可用"""
    tool = TOOLS[tool_key]
    try:
        # 只检查命令的第一部分（不包括参数）
        cmd = tool["command"].split()[0]
        result = subprocess.run(["which", cmd], capture_output=True, text=True)
        return result.returncode == 0
    except:
        return False

def get_tool_version(tool_key):
    """获取工具版本"""
    tool = TOOLS[tool_key]
    try:
        # 只使用命令的第一部分来获取版本（不包括参数）
        cmd = tool["command"].split()[0]
        result = subprocess.run([cmd, "--version"],
                              capture_output=True, text=True, timeout=3)
        if result.returncode == 0:
            return result.stdout.strip().split('\n')[0]
    except:
        pass
    return "未知"

def switch_model(tool_key, model_idx):
    """切换到指定模型并启动 CLI"""
    tool = TOOLS[tool_key]

    # 找到对应的模型
    idx = 1
    target_model = None

    for category in tool["models"].values():
        for model in category["models"]:
            if idx == model_idx:
                target_model = model
                break
            idx += 1
        if target_model:
            break

    if not target_model:
        return

    clear_screen()
    print_box_header("         正在切换模型...", 68)
    print("║                                                              ║")
    print("║  工具：" + tool['name'].ljust(60) + " ║")
    print("║  模型：" + target_model['name'].ljust(60) + " ║")
    print("║  说明：" + target_model['desc'].ljust(60) + " ║")
    print("║                                                              ║")
    print("║  正在切换...                                                 ║")
    print_box_footer(68)

    # 使用 cli-switch 并传递 --tool 参数以支持跨工具切换
    result = subprocess.run(["cli-switch", "--tool", tool_key, target_model["key"]])

    if result.returncode == 0:
        import os
        import sys
        cmd_parts = tool["command"].split()
        print()
        print("✅ 切换成功！")
        print()
        print(f"正在启动 {tool['name']}...")
        print()
        try:
            os.execvp(cmd_parts[0], cmd_parts)
        except Exception as e:
            print(f"启动失败: {e}")
            input("按回车键继续...")
        except Exception as e:
            print(f"启动失败: {e}")
            input("按回车键继续...")
    else:
        print()
        input("切换失败，按回车键继续...")

def test_all_tools():
    """测试所有工具"""
    results = {}

    for tool_key, tool in TOOLS.items():
        available = check_tool_available(tool_key)
        version = get_tool_version(tool_key) if available else "未安装"

        results[tool_key] = {
            "available": available,
            "version": version,
            "error": "工具未安装" if not available else None
        }

    clear_screen()
    print_test_results(results)
    input("按回车键继续...")

def get_total_model_count(tool_key):
    """获取工具的总模型数量"""
    total = 0
    for category in TOOLS[tool_key]["models"].values():
        total += len(category["models"])
    return total

def get_input(prompt, max_option):
    """获取用户输入"""
    while True:
        try:
            choice = input(prompt).strip()
            if choice == '0':
                return '0'
            if choice.isdigit():
                num = int(choice)
                if 1 <= num <= max_option:
                    return choice
            print(f"请输入 1-{max_option} 或 0 之间的数字")
        except KeyboardInterrupt:
            raise

def main():
    """主程序"""
    # 启动时验证配置
    errors = validate_config()
    if errors:
        print("⚠️  配置警告：")
        for e in errors:
            print(f"  - {e}")
        print()
        input("按回车键继续（部分功能可能不可用）...")

    while True:
        try:
            clear_screen()
            print_main_menu()

            choice = get_input("请选择 (0-4): ", 4)

            if choice == '0':
                clear_screen()
                print("👋 再见！")
                break

            elif choice in ['1', '2', '3']:
                # 选择工具
                tool_keys = list(TOOLS.keys())
                tool_key = tool_keys[int(choice) - 1]

                # 检查工具是否可用
                if not check_tool_available(tool_key):
                    clear_screen()
                    print_box_header("         错误", 68)
                    print("║                                                              ║")
                    print("║  ⚠️  " + TOOLS[tool_key]['name'] + " 未安装，无法使用                        ║")
                    print_box_footer(68)
                    input("按回车键继续...")
                    continue

                # 显示模型选择菜单
                while True:
                    clear_screen()
                    print_models_menu(tool_key)

                    total_models = get_total_model_count(tool_key)
                    model_choice = get_input(f"请选择模型 (1-{total_models}, 0 返回): ", total_models)

                    if model_choice == '0':
                        break

                    switch_model(tool_key, int(model_choice))

            elif choice == '4':
                test_all_tools()

        except KeyboardInterrupt:
            clear_screen()
            print("\n👋 再见！")
            break

if __name__ == "__main__":
    main()
