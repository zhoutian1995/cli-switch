{
  "name": "cli-switch",
  "version": "1.0.0",
  "description": "AI Agent orchestration layer — smart routing, multi-agent dispatching, and runtime compatibility for Claude Code, Codex CLI, and Gemini CLI",
  "keywords": [
    "ai",
    "agent",
    "claude-code",
    "codex",
    "gemini",
    "orchestration",
    "cli",
    "routing"
  ],
  "author": "zhoutian1995",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhoutian1995/cli-switch.git"
  },
  "bugs": {
    "url": "https://github.com/zhoutian1995/cli-switch/issues"
  },
  "homepage": "https://github.com/zhoutian1995/cli-switch#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "bin": {
    "cli-switch": "dist/cmd/root.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:agent": "vitest run test/unit/router test/unit/dispatcher test/unit/intent",
    "test:stress": "vitest run test/stress",
    "test:all": "vitest run",
    "test:git": "vitest run test/unit/git-guard test/unit/secret-detector",
    "smoke": "npm run build && node scripts/smoke-test.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "commander": "^14.0.0",
    "js-yaml": "^4.1.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.6.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
